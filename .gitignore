.env
data/
target/
node_modules/
ui/dist/
predictors/flux-mlp/Manifest.toml
predictors/flux-cnn/Manifest.toml
predictors/.venv/
# Python bytecode caches at any depth (nested predictor/pipeline dirs included)
__pycache__/
*.pyc
# Raw Spotify export data (instance data; rebuilt into the Qdrant corpus)
extended-2026/
docs/figures/*.pdf
docs/experiments.pdf
docs/api.pdf
dist/
.zig-cache/

# Vendored corpus-build pipeline: large metadata caches (regenerable via enrich),
# working intermediates, the rebuilt master CSV, and the gensim venv.
pipeline/corpus/cache/
pipeline/corpus/out/
pipeline/corpus/master_df.csv
pipeline/corpus/.venv/
pipeline/corpus/__pycache__/

# Instance restore bundle: Qdrant snapshots + a data tarball (~470 MB, one file
# over GitHub's 100 MB limit). Regenerated by deploy/; see deploy/README.md.
instance-bundle/

# predictors/.venv is a SYMLINK to the sibling instance's venv, so the
# `predictors/.venv/` directory pattern above does not match it.
predictors/.venv

# Baked client assets — regenerated by the bakers in each client's tools/
# (bake_gru.py, bake_projector.py, build_discovery.py) from the corpus + a
# promoted checkpoint. Big, binary, and derived: keep them out of history.
clients/*/public/model/
clients/*/public/catalog.json
