# Production stack environment — copy to deploy/.env (gitignored; never commit).
# Consumed by deploy/docker-compose.yml.

# ─── Postgres (metadata store) ───────────────────────────────────────────────
LENSING_DB_USER=pg
LENSING_DB_PASSWORD=change-me
LENSING_DB_NAME=lensing

# ─── Server ──────────────────────────────────────────────────────────────────
# Host port published for the Caddy router (http://nexttrack.snappler -> :8096).
LENSING_PORT=8096
# Qdrant collection the corpus lives in.
LENSING_COLLECTION=spotify_tracks

# ─── Optional integrations ───────────────────────────────────────────────────
# Spotify Web API (client-credentials) — corpus refresh + manual-track enrich.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
# OpenAI — content embedding for new manual tracks / corpus refresh.
OPENAI_API_KEY=
