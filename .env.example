# Copy to .env (gitignored) and fill in. The lensing-server loads .env at
# startup (dotenvy); the pathfinder sidecar inherits these.

# --- Spotify playlist export (Pathfinder → "Export to Spotify") ---
# Create an app at https://developer.spotify.com/dashboard, then:
#   1. copy its Client ID + Client Secret here,
#   2. add this exact Redirect URI to the app's settings:
#        http://127.0.0.1:8095/api/pathfinder/spotify/callback
#      (Spotify's http loopback exemption requires the literal 127.0.0.1 host;
#       match the port to your -Dport / --port.)
# Without these, the Pathfinder page still works — only the export button is
# disabled, with a hint pointing back here.
SPOTIFY_CLIENT_ID=e4c1abc2559b40378248b3e2b89dc8f1
SPOTIFY_CLIENT_SECRET=ffe46f9b6f174dd2a28f4d67139bb48d
# Optional: only set if you change the server port or want a different callback.
# Defaults to {server URL}/api/pathfinder/spotify/callback.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8095/api/pathfinder/spotify/callback
